BOT_IMAGE=ghcr.io/evgenykravchenko/vk-content-bot
BOT_VERSION=0.2.0

VK_TOKEN=replace-on-server
VK_VIDEO_TOKEN=replace-with-user-oauth-token
VK_VIDEO_REFRESH_TOKEN=replace-with-user-refresh-token
VK_VIDEO_DEVICE_ID=replace-with-oauth-device-id
VK_VIDEO_CLIENT_ID=54858060
VK_VIDEO_REDIRECT_URI=https://bot-content-cms.tailcc0b45.ts.net/vk-oauth/callback
VK_VIDEO_TOKEN_EXPIRES_AT=0
VK_GROUP_ID=123456789
VK_MEDIA_UPLOAD_PEER_ID=123456789

BOTCRM_URL=http://api:4100/api/v1
BOTCRM_CONTENT_TOKEN=replace-on-server
BOTCRM_DIALOG_TOKEN=replace-with-botcrm-service-token
BOTCRM_WORKSPACE_ID=ws_demo
BOTCRM_BOT_SLUG=vk_content_bot

YANDEX_DISK_TOKEN=replace-on-server
YANDEX_DISK_ROOT=/VK Bot

LOG_LEVEL=info
RULE_CACHE_TTL_SECONDS=30
MEDIA_POLL_INTERVAL_SECONDS=20
MEDIA_BATCH_SIZE=3

