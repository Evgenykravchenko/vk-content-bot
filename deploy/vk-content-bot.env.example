BOT_IMAGE=ghcr.io/evgenykravchenko/vk-content-bot
BOT_VERSION=0.2.0

VK_TOKEN=replace-on-server
VK_GROUP_ID=123456789
VK_MEDIA_UPLOAD_PEER_ID=123456789

BOTCRM_URL=http://api:4100/api/v1
BOTCRM_CONTENT_TOKEN=replace-on-server

YANDEX_DISK_TOKEN=replace-on-server
YANDEX_DISK_ROOT=/VK Bot

LOG_LEVEL=info
RULE_CACHE_TTL_SECONDS=30
MEDIA_POLL_INTERVAL_SECONDS=20
MEDIA_BATCH_SIZE=3

