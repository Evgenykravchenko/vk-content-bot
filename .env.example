# --- VK ---
VK_TOKEN=replace_with_community_token
VK_GROUP_ID=123456789
# ID вашего личного VK-аккаунта, который уже написал боту.
# VK требует peer_id для предварительной загрузки фото и документов.
VK_MEDIA_UPLOAD_PEER_ID=123456789

# --- Directus ---
DIRECTUS_URL=http://directus:8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace_with_strong_admin_password
DIRECTUS_TOKEN=replace-with-a-long-random-token
DIRECTUS_SECRET=replace-with-another-long-random-secret
# Для чистого запуска оставьте false. true добавит тестовую команду «помощь».
DIRECTUS_SEED_DEMO=false

# --- PostgreSQL ---
POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=replace_with_strong_database_password

# --- Яндекс Диск ---
# Оставьте пустым, если пока проверяете только текстовые ответы.
YANDEX_DISK_TOKEN=
YANDEX_DISK_ROOT=/VK Bot

# --- Приложение ---
LOG_LEVEL=info
RULE_CACHE_TTL_SECONDS=30
MEDIA_POLL_INTERVAL_SECONDS=20
MEDIA_BATCH_SIZE=3
