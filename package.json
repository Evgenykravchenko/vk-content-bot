{
  "name": "vk-content-bot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "VK-бот для управляемой выдачи текста и медиа по ключевым словам",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cms:bootstrap": "node scripts/bootstrap-directus.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pino": "^9.9.0",
    "vk-io": "^4.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
